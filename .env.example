# ===== LLM 配置（支持 OpenAI 兼容接口：DeepSeek、通义千问、本地模型等）=====
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 排除，不会提交
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ===== Embedding 配置（sentence-transformers 本地模型，无需 API）=====
EMBEDDING_MODEL=models/bge-base-zh-v1.5
EMBEDDING_DIM=768
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 数据库配置 =====
DATABASE_URL=sqlite:///./storage/financial.db
CHROMA_PERSIST_DIR=./storage/chroma_db

# ===== RAG 配置 =====
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
HYBRID_ALPHA=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ===== 标签配置 =====
TAG_CONFIDENCE_THRESHOLD=0.7
AUTO_EVOLVE_ENABLED=true

# ===== 简报配置 =====
REPORT_MAX_NEWS=50
REPORT_MIN_CONFIDENCE=0.6

# ===== 服务配置 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
